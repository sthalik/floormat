set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT /opt/aarch64_be-floormat-sysroot)
set(CMAKE_C_COMPILER /opt/aarch64_be-sysroot/bin/aarch64_be-none-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER /opt/aarch64_be-sysroot/bin/aarch64_be-none-linux-gnu-g++)
set(_fm_sve_bits "$ENV{FLOORMAT_SVE_BITS}")
if(_fm_sve_bits STREQUAL "")
    set(_fm_sve_bits 512)
endif()
if(NOT _fm_sve_bits MATCHES "^(128|512)$")
    message(FATAL_ERROR "FLOORMAT_SVE_BITS must be 128 or 512")
endif()
math(EXPR _fm_sve_bytes "${_fm_sve_bits} / 8")
set(CMAKE_C_FLAGS_INIT "-march=armv8.2-a+sve -msve-vector-bits=${_fm_sve_bits}")
set(CMAKE_CXX_FLAGS_INIT "-march=armv8.2-a+sve -msve-vector-bits=${_fm_sve_bits}")
set(CMAKE_CROSSCOMPILING_EMULATOR qemu-aarch64_be
    -cpu "max,sve${_fm_sve_bits}=on,sve-default-vector-length=${_fm_sve_bytes}"
    -L /opt/aarch64_be-floormat-sysroot)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(FLOORMAT_USERCONFIG "${CMAKE_CURRENT_LIST_DIR}/../.github/aarch64-be.cmake")
set(ENV{PKG_CONFIG_LIBDIR} /opt/aarch64_be-floormat-sysroot/usr/lib/pkgconfig:/opt/aarch64_be-floormat-sysroot/usr/share/pkgconfig)
set(ENV{PKG_CONFIG_SYSROOT_DIR} /opt/aarch64_be-floormat-sysroot)
set(ENV{PKG_CONFIG_PATH} "")
